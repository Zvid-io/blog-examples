{
  "name": "call-notes-explainer",
  "resolution": "custom",
  "width": 1280,
  "height": 720,
  "frameRate": 30,
  "outputFormat": "mp4",
  "backgroundColor": "#103A31",
  "variables": {
    "title": "Call notes to next steps",
    "features": [
      {
        "heading": "Summarize",
        "body": "Capture decisions and open questions."
      },
      {
        "heading": "Draft",
        "body": "Prepare a follow-up for review."
      },
      {
        "heading": "Route",
        "body": "Assign the reviewed task to its owner."
      }
    ],
    "showCta": true,
    "cta": "Review the full workflow"
  },
  "scenes": [
    {
      "id": "intro",
      "duration": 2,
      "visuals": [
        {
          "type": "TEXT",
          "text": "{{title}}",
          "x": 80,
          "y": 270,
          "width": 1120,
          "height": 120,
          "style": {
            "fontSize": "52px",
            "color": "#FFF8ED",
            "fontFamily": "Arial",
            "textAlign": "center"
          }
        }
      ]
    },
    {
      "id": "feature",
      "iterate": "features",
      "iterateAs": "feature",
      "duration": 3,
      "visuals": [
        {
          "type": "TEXT",
          "text": "{{feature.heading}}",
          "x": 80,
          "y": 200,
          "width": 1120,
          "height": 120,
          "style": {
            "fontSize": "52px",
            "color": "#FFF8ED",
            "fontFamily": "Arial",
            "textAlign": "center"
          }
        },
        {
          "type": "TEXT",
          "text": "{{feature.body}}",
          "x": 80,
          "y": 340,
          "width": 1120,
          "height": 120,
          "style": {
            "fontSize": "34px",
            "color": "#FFF8ED",
            "fontFamily": "Arial",
            "textAlign": "center"
          }
        }
      ]
    },
    {
      "id": "cta",
      "condition": "{{showCta}}",
      "duration": 2,
      "visuals": [
        {
          "type": "TEXT",
          "text": "{{cta}}",
          "x": 80,
          "y": 270,
          "width": 1120,
          "height": 120,
          "style": {
            "fontSize": "48px",
            "color": "#FFF8ED",
            "fontFamily": "Arial",
            "textAlign": "center"
          }
        }
      ]
    }
  ]
}
