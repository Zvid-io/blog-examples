{
  "name": "zvid-blog-video-template-validation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "render": "node --env-file=.env src/index.js --render",
    "resume": "node --env-file=.env src/index.js --resume",
    "check": "node --check src/index.js && node --check src/preflight.js && node --check src/api.js && node --check src/helpers.js",
    "test": "node --test tests/*.test.js"
  }
}
